class Solution {
    public int minimumLength(String s) {
        int n = s.length();
        Map<Character , Integer> map = new HashMap<>();
        for(int i = 0 ; i < n; i++){
            char ch = s.charAt(i);
            map.put(ch , map.getOrDefault(ch , 0) + 1);
        }
        int count = 0;
        for(int i : map.values()){
           if(i % 2 == 0)
              count += 2;
           else
              count += 1;
        }
        return count;
    }
}
